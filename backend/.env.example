# Backend Environment Variables (FastAPI)
# Copy this file to .env and configure as needed.
# All settings have safe defaults; no credentials are required for basic local startup.

# GitHub API Token (optional)
# Raises the GitHub REST API rate limit from 60 to 5,000 requests/hour.
# Leave blank to use unauthenticated requests.
GITHUB_TOKEN=

# GitHub Cache TTL (optional)
# How long (in seconds) GitHub profile and repository responses are cached in memory.
# Default is 300 (5 minutes). Set to 0 to disable in-memory caching.
GITHUB_CACHE_TTL=300

# AI Configuration (optional, for AI-powered issue analysis)
# Uses the OpenAI API. Leave blank if you are not testing AI analysis endpoints.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
